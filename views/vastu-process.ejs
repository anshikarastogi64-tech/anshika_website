<!DOCTYPE html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>Vastu-Compliant Interior Design Process | <%= footerName %></title>
  <meta name="description" content="Discover our comprehensive 11-step Vastu-compliant interior design process that combines ancient wisdom with modern luxury to create harmonious living spaces.">
  <meta name="keywords" content="vastu shastra, vastu interior design, vastu consultant, vastu compliant homes, interior design india, panch tatva">

  <!-- Favicons -->
  <link href="/assets/img/favicon.png" rel="icon" />
  <link href="/assets/img/apple-touch-icon.png" rel="apple-touch-icon" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Raleway:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- CSS Files -->
  <link href="/assets/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/assets/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet" />
  <link href="/assets/css/style.css" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root {
      --vastu-gold: #FFD700;
      --vastu-deep-red: #8B0000;
      --vastu-purple: #6B4C9A;
      --vastu-green: #2D5F2E;
      --vastu-earth: #8B7355;
      --cosmic-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      --gold-gradient: linear-gradient(135deg, #f09819 0%, #edde5d 100%);
    }

    body {
      font-family: 'Georgia', serif;
      overflow-x: hidden;
    }

    /* Hero Section with Cosmic Energy */
    .vastu-hero {
      position: relative;
      min-height: 70vh;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      margin-top: 72px;
    }

    .vastu-hero::before {
      content: '';
      position: absolute;
      width: 300%;
      height: 300%;
      background: radial-gradient(circle, rgba(255,215,0,0.1) 1%, transparent 2%);
      background-size: 50px 50px;
      animation: cosmicFlow 60s linear infinite;
    }

    @keyframes cosmicFlow {
      0% { transform: translate(0, 0) rotate(0deg); }
      100% { transform: translate(-50px, -50px) rotate(360deg); }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      color: white;
      padding: 2rem;
    }

    .hero-title {
      font-size: 3.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      background: var(--gold-gradient);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      animation: titleGlow 3s ease-in-out infinite;
    }

    @keyframes titleGlow {
      0%, 100% { filter: brightness(1); }
      50% { filter: brightness(1.3); }
    }

    .hero-subtitle {
      font-size: 1.5rem;
      color: #FFD700;
      margin-bottom: 2rem;
      opacity: 0.9;
    }

    .compass-decoration {
      position: absolute;
      width: 400px;
      height: 400px;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      opacity: 0.15;
      animation: rotate 60s linear infinite;
    }

    @keyframes rotate {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

    /* Process Steps */
    .process-section {
      padding: 5rem 0;
      background: linear-gradient(180deg, #fff 0%, #f8f9fa 100%);
    }

    .section-header {
      text-align: center;
      margin-bottom: 4rem;
    }

    .section-title {
      font-size: 3rem;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 1rem;
    }

    .section-subtitle {
      font-size: 1.2rem;
      color: #666;
      max-width: 800px;
      margin: 0 auto;
    }

    .process-timeline {
      position: relative;
      max-width: 1200px;
      margin: 0 auto;
    }

    .process-step {
      position: relative;
      padding: 2rem 0;
      display: flex;
      gap: 3rem;
      opacity: 0;
      transform: translateY(50px);
      transition: all 0.6s ease;
    }

    .process-step.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .process-step:nth-child(even) {
      flex-direction: row-reverse;
    }

    .step-number {
      flex-shrink: 0;
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--cosmic-gradient);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      font-weight: 700;
      box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
      position: relative;
      z-index: 2;
    }

    .step-content {
      flex: 1;
      background: white;
      padding: 2.5rem;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.08);
      transition: all 0.3s ease;
    }

    .step-content:hover {
      transform: translateY(-10px);
      box-shadow: 0 20px 60px rgba(0,0,0,0.15);
    }

    .step-title {
      font-size: 1.8rem;
      font-weight: 700;
      color: #1a1a2e;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .step-icon {
      width: 50px;
      height: 50px;
      border-radius: 12px;
      background: var(--gold-gradient);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 1.5rem;
    }

    .step-description {
      color: #555;
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 1.5rem;
    }

    .step-list {
      list-style: none;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
    }

    .step-list li {
      padding: 0.8rem 1.2rem;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      border-radius: 10px;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      transition: all 0.3s ease;
    }

    .step-list li:hover {
      transform: scale(1.05);
      background: var(--gold-gradient);
      color: white;
    }

    .step-list li i {
      color: var(--vastu-deep-red);
    }

    .step-list li:hover i {
      color: white;
    }

    /* Five Elements Section */
    .elements-section {
      padding: 5rem 0;
      background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
      position: relative;
      overflow: hidden;
    }

    .elements-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 2rem;
      max-width: 1400px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    .element-card {
      background: rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      border-radius: 20px;
      padding: 2.5rem;
      text-align: center;
      border: 2px solid rgba(255,215,0,0.3);
      transition: all 0.4s ease;
      cursor: pointer;
    }

    .element-card:hover {
      transform: translateY(-20px) scale(1.05);
      border-color: #FFD700;
      background: rgba(255,215,0,0.15);
      box-shadow: 0 30px 60px rgba(255,215,0,0.3);
    }

    .element-icon {
      font-size: 4rem;
      margin-bottom: 1.5rem;
    }

    .element-name {
      font-size: 1.8rem;
      font-weight: 700;
      color: #FFD700;
      margin-bottom: 1rem;
    }

    .element-description {
      color: rgba(255,255,255,0.8);
      font-size: 1rem;
    }

    /* Benefits Section */
    .benefits-section {
      padding: 5rem 0;
      background: white;
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2rem;
      max-width: 1200px;
      margin: 3rem auto 0;
      padding: 0 2rem;
    }

    .benefit-card {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 20px;
      padding: 2.5rem;
      color: white;
      text-align: center;
      transition: all 0.3s ease;
      position: relative;
      overflow: hidden;
    }

    .benefit-card::before {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
      transform: scale(0);
      transition: transform 0.6s ease;
    }

    .benefit-card:hover::before {
      transform: scale(1);
    }

    .benefit-card:hover {
      transform: translateY(-15px);
      box-shadow: 0 25px 50px rgba(102, 126, 234, 0.4);
    }

    .benefit-icon {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      position: relative;
      z-index: 1;
    }

    .benefit-title {
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 1rem;
      position: relative;
      z-index: 1;
    }

    /* Advanced Services Section */
    .advanced-section {
      padding: 5rem 0;
      background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
    }

    .advanced-card {
      max-width: 900px;
      margin: 3rem auto;
      background: white;
      border-radius: 30px;
      padding: 3rem;
      box-shadow: 0 20px 60px rgba(0,0,0,0.1);
      border: 3px solid #FFD700;
    }

    .advanced-badge {
      display: inline-block;
      background: var(--gold-gradient);
      color: white;
      padding: 0.8rem 2rem;
      border-radius: 50px;
      font-weight: 700;
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    .advanced-features {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin: 2rem 0;
    }

    .advanced-feature {
      padding: 1.5rem;
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      border-radius: 15px;
      border-left: 4px solid var(--vastu-deep-red);
    }

    /* CTA Section */
    .cta-section {
      padding: 5rem 0;
      background: linear-gradient(135deg, #8B0000 0%, #6B4C9A 100%);
      color: white;
      text-align: center;
    }

    .cta-title {
      font-size: 3rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
    }

    .cta-subtitle {
      font-size: 1.3rem;
      margin-bottom: 3rem;
      opacity: 0.95;
    }

    .cta-button {
      display: inline-block;
      padding: 1.5rem 4rem;
      background: var(--gold-gradient);
      color: #1a1a2e;
      font-size: 1.3rem;
      font-weight: 700;
      border-radius: 50px;
      text-decoration: none;
      transition: all 0.3s ease;
      box-shadow: 0 15px 40px rgba(255,215,0,0.4);
    }

    .cta-button:hover {
      transform: translateY(-5px);
      box-shadow: 0 25px 60px rgba(255,215,0,0.6);
      color: #1a1a2e;
    }

    @media (max-width: 768px) {
      .vastu-hero { min-height: 50vh; margin-top: 60px; }
      .hero-title { font-size: 2.5rem; }
      .hero-subtitle { font-size: 1.2rem; }
      .section-title { font-size: 2rem; }
      .process-step { flex-direction: column !important; gap: 1.5rem; }
      .step-number { width: 60px; height: 60px; font-size: 1.5rem; }
      .elements-grid { grid-template-columns: 1fr; }
      .cta-title { font-size: 2rem; }
      .cta-button { padding: 1.2rem 2.5rem; font-size: 1.1rem; }
    }
  </style>
</head>
<body>

  <%- include('partials/layout', {
    active: 'vastu',
    footerName: typeof footerName !== 'undefined' ? footerName : 'Anshika Rastogi',
    body: `
