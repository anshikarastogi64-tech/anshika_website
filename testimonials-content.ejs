<style>
  /* Hide default header for testimonials page */
  body #header {
    display: none !important;
  }

  body {
    padding-top: 0 !important;
  }

  /* Testimonials Magical Theme */
  #testimonials-magical {
    background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
    min-height: 100vh;
    position: relative;
    overflow: hidden;
    padding: 0;
  }

  /* Custom Header matching home page */
  .testimonials-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background: rgba(15, 12, 41, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 215, 0, 0.2);
    padding: 15px 0;
    transition: all 0.3s;
  }

  .testimonials-header.scrolled {
    background: rgba(15, 12, 41, 0.98);
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
  }

  .testimonials-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .testimonials-logo {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 50%, #FFD700 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    text-shadow: none;
    letter-spacing: 3px;
    position: relative;
    animation: shimmer 3s ease-in-out infinite;
    transition: all 0.3s;
  }

  @keyframes shimmer {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .testimonials-logo::before {
    content: '✨';
    position: absolute;
    left: -30px;
    font-size: 20px;
    animation: sparkle-left 2s ease-in-out infinite;
  }

  .testimonials-logo::after {
    content: '✨';
    position: absolute;
    right: -30px;
    font-size: 20px;
    animation: sparkle-right 2s ease-in-out infinite;
  }

  @keyframes sparkle-left {
    0%, 100% {
      opacity: 0.5;
      transform: rotate(0deg) scale(1);
    }
    50% {
      opacity: 1;
      transform: rotate(180deg) scale(1.2);
    }
  }

  @keyframes sparkle-right {
    0%, 100% {
      opacity: 1;
      transform: rotate(0deg) scale(1.2);
    }
    50% {
      opacity: 0.5;
      transform: rotate(-180deg) scale(1);
    }
  }

  .testimonials-logo:hover {
    transform: scale(1.08);
    letter-spacing: 4px;
  }

  .testimonials-nav-links {
    display: flex;
    gap: 40px;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .testimonials-nav-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-weight: 500;
    font-size: 15px;
    transition: all 0.3s;
    position: relative;
  }

  .testimonials-nav-links a:hover {
    color: #FFD700;
  }

  .testimonials-nav-links a.active {
    color: #FFD700;
  }

  .testimonials-nav-links a::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 2px;
    background: #FFD700;
    transition: width 0.3s;
  }

  .testimonials-nav-links a:hover::after,
  .testimonials-nav-links a.active::after {
    width: 100%;
  }

  .mobile-menu-toggle {
    display: none;
    background: none;
    border: none;
    color: #FFD700;
    font-size: 28px;
    cursor: pointer;
  }

  /* Mobile Menu */
  @media (max-width: 768px) {
    .testimonials-nav-links {
      position: fixed;
      top: 60px;
      right: -100%;
      width: 70%;
      height: calc(100vh - 60px);
      background: rgba(15, 12, 41, 0.98);
      flex-direction: column;
      align-items: flex-start;
      padding: 30px;
      gap: 25px;
      transition: right 0.3s;
      box-shadow: -5px 0 20px rgba(0, 0, 0, 0.3);
    }

    .testimonials-nav-links.active {
      right: 0;
    }

    .mobile-menu-toggle {
      display: block;
    }
  }

  /* Add padding to content for fixed header */
  .testimonials-content {
    padding-top: 80px;
  }

  /* Floating stars background */
  .testimonials-stars {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .testimonials-star {
    position: absolute;
    background: #FFD700;
    border-radius: 50%;
    animation: twinkle 3s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  .testimonials-content {
    position: relative;
    z-index: 2;
  }

  /* Hero Section */
  .testimonials-hero {
    text-align: center;
    margin-bottom: 60px;
    padding: 40px 0;
  }

  .testimonials-hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: 56px;
    font-weight: 700;
    color: #FFD700;
    margin-bottom: 20px;
    text-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
    animation: fadeInDown 1s ease;
  }

  .testimonials-hero p {
    font-size: 20px;
    color: rgba(255, 255, 255, 0.8);
    max-width: 700px;
    margin: 0 auto 30px;
    line-height: 1.6;
  }

  .testimonials-stats {
    display: flex;
    justify-content: center;
    gap: 60px;
    flex-wrap: wrap;
    margin-top: 40px;
  }

  .stat-item {
    text-align: center;
  }

  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 700;
    color: #FFD700;
    display: block;
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
  }

  .stat-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-top: 8px;
  }

  /* Testimonial Cards */
  .testimonial-card-magical {
    background: linear-gradient(135deg, rgba(26, 26, 46, 0.95), rgba(15, 52, 96, 0.95));
    border-radius: 20px;
    padding: 35px;
    margin-bottom: 30px;
    border: 2px solid rgba(255, 215, 0, 0.3);
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
    cursor: pointer;
    text-decoration: none;
    display: block;
  }

  .testimonial-card-magical::before {
    content: '✨';
    position: absolute;
    top: -20px;
    right: -20px;
    font-size: 100px;
    opacity: 0.1;
    transition: all 0.4s;
  }

  .testimonial-card-magical:hover {
    transform: translateY(-10px) scale(1.02);
    border-color: #FFD700;
    box-shadow: 0 20px 60px rgba(255, 215, 0, 0.4), 0 0 40px rgba(255, 215, 0, 0.2);
  }

  .testimonial-card-magical:hover::before {
    top: -10px;
    right: -10px;
    opacity: 0.2;
    transform: rotate(15deg);
  }

  .testimonial-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
  }

  .testimonial-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid #FFD700;
    object-fit: cover;
    box-shadow: 0 8px 20px rgba(255, 215, 0, 0.3);
  }

  .testimonial-avatar-placeholder {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 3px solid rgba(255, 215, 0, 0.5);
    background: linear-gradient(135deg, #FFD700, #FFA500);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36px;
    color: #1a1a2e;
    box-shadow: 0 8px 20px rgba(255, 215, 0, 0.3);
  }

  .testimonial-info h3 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    color: #FFD700;
    margin: 0 0 5px 0;
  }

  .testimonial-info h4 {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-weight: 400;
  }

  .testimonial-rating {
    display: flex;
    gap: 5px;
    margin-top: 8px;
  }

  .testimonial-rating i {
    font-size: 18px;
    color: #FFD700;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
  }

  .verified-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(76, 175, 80, 0.2);
    border: 1px solid #4CAF50;
    color: #4CAF50;
    padding: 4px 12px;
    border-radius: 12px;
    font-size: 12px;
    font-weight: 600;
    margin-top: 8px;
  }

  .testimonial-message {
    font-size: 16px;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.9);
    margin: 20px 0;
    position: relative;
    padding: 20px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 15px;
    border-left: 4px solid #FFD700;
  }

  .quote-icon {
    font-size: 32px;
    color: rgba(255, 215, 0, 0.3);
  }

  .testimonial-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .project-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 215, 0, 0.1);
    border: 1px solid rgba(255, 215, 0, 0.3);
    color: #FFD700;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
  }

  .read-more-btn {
    color: #FFD700;
    font-weight: 600;
    font-size: 14px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.3s;
  }

  .read-more-btn:hover {
    color: #FFA500;
    transform: translateX(5px);
  }

  /* Animations */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.8s ease forwards;
    opacity: 0;
  }

  .fade-in-up:nth-child(1) { animation-delay: 0.1s; }
  .fade-in-up:nth-child(2) { animation-delay: 0.2s; }
  .fade-in-up:nth-child(3) { animation-delay: 0.3s; }
  .fade-in-up:nth-child(4) { animation-delay: 0.4s; }
  .fade-in-up:nth-child(5) { animation-delay: 0.5s; }
  .fade-in-up:nth-child(6) { animation-delay: 0.6s; }

  /* CTA Section */
  .testimonials-cta {
    text-align: center;
    margin-top: 80px;
    padding: 60px 20px;
    background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), rgba(255, 165, 0, 0.1));
    border-radius: 30px;
    border: 2px solid rgba(212, 175, 55, 0.3);
  }

  .testimonials-cta h2 {
    font-family: 'Playfair Display', serif;
    font-size: 42px;
    color: #FFD700;
    margin-bottom: 20px;
  }

  .testimonials-cta p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 30px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-button {
    display: inline-block;
    padding: 18px 45px;
    background: linear-gradient(135deg, #D4AF37 0%, #FFA500 100%);
    color: #1a1a2e;
    text-decoration: none;
    border-radius: 30px;
    font-weight: 700;
    font-size: 18px;
    box-shadow: 0 10px 30px rgba(212, 175, 55, 0.4);
    transition: all 0.3s;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .cta-button:hover {
    transform: translateY(-5px);
    box-shadow: 0 15px 40px rgba(212, 175, 55, 0.6);
    color: #1a1a2e;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .testimonials-hero h1 {
      font-size: 36px;
    }

    .testimonials-hero p {
      font-size: 16px;
    }

    .stat-number {
      font-size: 36px;
    }

    .testimonials-stats {
      gap: 30px;
    }

    .testimonial-card-magical {
      padding: 25px;
    }

    .testimonial-header {
      flex-direction: column;
      text-align: center;
    }

    .testimonial-footer {
      flex-direction: column;
      gap: 15px;
      align-items: flex-start;
    }

    .testimonials-cta h2 {
      font-size: 32px;
    }
  }
</style>

<section id="testimonials-magical">
  <!-- Custom Header -->
  <header class="testimonials-header">
    <nav class="testimonials-nav">
      <a href="/" class="testimonials-logo">ANSHIKA</a>

      <button class="mobile-menu-toggle" onclick="document.querySelector('.testimonials-nav-links').classList.toggle('active')">
        <i class="bx bx-menu"></i>
      </button>

      <ul class="testimonials-nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a href="/testimonials" class="active">Testimonials</a></li>
        <li><a href="/portal/login">Client Portal</a></li>
        <li><a href="/#contact" style="color: #FFD700;">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- Floating Stars Background -->
  <div class="testimonials-stars">
    <div class="testimonials-star" style="width: 3px; height: 3px; top: 10%; left: 20%; animation-delay: 0s;"></div>
    <div class="testimonials-star" style="width: 2px; height: 2px; top: 20%; left: 80%; animation-delay: 0.5s;"></div>
    <div class="testimonials-star" style="width: 4px; height: 4px; top: 30%; left: 50%; animation-delay: 1s;"></div>
    <div class="testimonials-star" style="width: 3px; height: 3px; top: 50%; left: 10%; animation-delay: 1.5s;"></div>
    <div class="testimonials-star" style="width: 2px; height: 2px; top: 60%; left: 90%; animation-delay: 2s;"></div>
    <div class="testimonials-star" style="width: 3px; height: 3px; top: 80%; left: 30%; animation-delay: 2.5s;"></div>
    <div class="testimonials-star" style="width: 4px; height: 4px; top: 70%; left: 70%; animation-delay: 3s;"></div>
  </div>

  <div class="testimonials-content container">
    <!-- Hero Section -->
    <div class="testimonials-hero">
      <h1>✨ Dream Homes, Real Stories ✨</h1>
      <p>Hear from our delighted clients who trusted us to transform their spaces into magical sanctuaries where memories are made and dreams come alive.</p>

      <!-- Stats -->
      <div class="testimonials-stats">
        <div class="stat-item">
          <span class="stat-number">300+</span>
          <span class="stat-label">Dream Homes</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Satisfaction</span>
        </div>
        <div class="stat-item">
          <span class="stat-number">5.0</span>
          <span class="stat-label">Average Rating</span>
        </div>
      </div>
    </div>

    <!-- Testimonials Grid -->
    <div class="row g-4">
      <% const list = (typeof testimonials !== 'undefined' && Array.isArray(testimonials)) ? testimonials : []; %>
      <% const mediaMap = typeof mediaByTestimonial !== 'undefined' ? mediaByTestimonial : {}; %>

      <% list.forEach(function(t, index) { %>
      <div class="col-lg-6 fade-in-up">
        <a href="/testimonials/<%= t.id %>" class="testimonial-card-magical">
          <div class="testimonial-header">
            <% if (t.image_path) { %>
              <img loading="lazy" src="/<%= t.image_path %>" class="testimonial-avatar" alt="<%= t.name %>">
            <% } else { %>
              <div class="testimonial-avatar-placeholder">
                <%= t.name ? t.name.charAt(0).toUpperCase() : '?' %>
              </div>
            <% } %>

            <div class="testimonial-info">
              <h3><%= t.name || 'Anonymous' %></h3>
              <h4><%= t.role || 'Valued Client' %></h4>

              <% if (t.rating && t.rating > 0) { %>
              <div class="testimonial-rating">
                <% for (var i = 1; i <= 5; i++) { %>
                  <i class="bx <%= i <= t.rating ? 'bxs-star' : 'bx-star' %>"></i>
                <% } %>
              </div>
              <% } %>

              <span class="verified-badge">
                <i class="bx bx-check-circle"></i> Verified Client
              </span>
            </div>
          </div>

          <div class="testimonial-message">
            <i class="bx bxs-quote-alt-left quote-icon"></i>
            <p style="margin: 10px 0 0 0;">
              <%= t.message && t.message.length > 200 ? t.message.substring(0, 200) + '...' : (t.message || 'Amazing experience working with Kelly Designers Vision!') %>
            </p>
          </div>

          <div class="testimonial-footer">
            <div class="project-tag">
              <i class="bx bx-home-heart"></i>
              <span>Dream Home Project</span>
            </div>
            <span class="read-more-btn">
              Read Full Story <i class="bx bx-right-arrow-alt"></i>
            </span>
          </div>
        </a>
      </div>
      <% }); %>
    </div>

    <% if (list.length === 0) { %>
    <div class="text-center py-5" style="color: rgba(255, 255, 255, 0.6);">
      <div style="font-size: 64px; margin-bottom: 20px;">✨</div>
      <h3 style="color: #FFD700;">More stories coming soon!</h3>
      <p>We're gathering beautiful testimonials from our delighted clients.</p>
    </div>
    <% } %>

    <!-- CTA Section -->
    <div class="testimonials-cta">
      <h2>Ready to Write Your Own Success Story?</h2>
      <p>Join hundreds of satisfied clients who trusted us to bring their dream homes to life. Let's create something magical together.</p>
      <a href="/Kelly/index.html#final-dream" class="cta-button">
        ✨ Start Your Dream Journey ✨
      </a>
    </div>
  </div>
</section>

<script>
// Add scroll animations
document.addEventListener('DOMContentLoaded', function() {
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver(function(entries) {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  document.querySelectorAll('.fade-in-up').forEach(el => {
    observer.observe(el);
  });

  // Header scroll effect
  window.addEventListener('scroll', function() {
    const header = document.querySelector('.testimonials-header');
    if (window.scrollY > 50) {
      header.classList.add('scrolled');
    } else {
      header.classList.remove('scrolled');
    }
  });
});
</script>
