# Server
PORT=8000
NODE_ENV=development

# Session - use a strong random string in production (e.g. openssl rand -hex 32)
SESSION_SECRET=change-this-to-a-random-secret

# Set to true when using HTTPS (e.g. behind nginx + Let's Encrypt)
SESSION_SECURE=false

# Email (portal notifications, meeting invites text) — see server env docs for SMTP variables
# EMAIL_HOST= EMAIL_PORT=465 EMAIL_USER= EMAIL_PASS=

# Payment reminders (soft ask -> hard ask). Email works with the SMTP vars above.
# How often the scheduler checks for due reminder campaigns (minutes, default 15):
# PAYMENT_REMINDER_TICK_MINUTES=15
#
# SMS is optional. With no provider set, SMS sends are skipped+logged and only
# email goes out. Pick ONE provider and fill its credentials to enable SMS:
#   SMS_PROVIDER=msg91   MSG91_AUTHKEY=  MSG91_SENDER=  MSG91_TEMPLATE_ID=   (India / DLT)
#   SMS_PROVIDER=twilio  TWILIO_SID=     TWILIO_TOKEN=  TWILIO_FROM=+1234567890
# SMS_DEFAULT_COUNTRY_CODE=91   # prepended to bare 10-digit numbers

# Optional: interactive map + Places search on portal “Site location & contact” (Maps JavaScript API + Places API)
# GOOGLE_MAPS_JS_API_KEY=

# Optional: automatic Google Calendar events + Meet links require Google Calendar API
# (OAuth or Workspace service account + domain-wide delegation). Not required for the
# built-in “Add to Google Calendar” + paste Meet link flow in the portal Meetings tab.
